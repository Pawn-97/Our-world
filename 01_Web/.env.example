# Initial map source: auto, cesium, tianditu, or local.
# auto preserves the first available source in this order: Cesium, Tianditu, local fallback.
VITE_MAP_SOURCE=auto

# Optional public-client token for Cesium ion online global imagery.
# Leave empty to use the bundled low-resolution Natural Earth II fallback.
# Every person who deploys Our World supplies an app-specific token from their own ion account.
# Copy this file to .env.local for development; never commit, document, or paste a real token into chat.
VITE_CESIUM_ION_TOKEN=

# Optional public-client key for Tianditu imagery and Chinese annotation tiles.
# Apply for your own key at https://lbs.tianditu.gov.cn/ and restrict production use in its console.
VITE_TIANDITU_TOKEN=

# Optional: force the neutral public demo even when private local data exists.
VITE_TRAVEL_ATLAS_DATA_MODE=local
